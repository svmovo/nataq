{
  "manifest_version": 3,
  "name": "نطق | Nataq",
  "version": "2.4.0",
  "author": "svmovo",
  "description": "دوس الأيقونة، اتكلم، وانسخ النص من غير ما تسيب الصفحة. By svmovo",
  "action": {
    "default_title": "نطق | Nataq"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
